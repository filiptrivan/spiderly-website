index 0000000..057f669
--- /dev/null
+++ b/.github/workflows/size-cap.yml
@@ -0,0 +1,23 @@
+name: Size cap
+
+# The Size cap over the whole tree on each push and pull request, by ci-workflows' reusable
+# size-cap.yml. It catches what .githooks/pre-commit cannot: a commit made with --no-verify, or in a
+# clone without the hooks or without ci-workflows beside it.
+
+on:
+  push:
+    branches: [develop]
+  # Into develop only, where the work lands: dependabot's, into master, change only package.json
+  # and its lockfile.
+  pull_request:
+    branches: [develop]
+
+# No concurrency group that cancels: the next push compares its list with this push's tip, so a
+# cancelled run would leave this push's added lines unjudged.
+
+permissions:
+  contents: read
+
+jobs:
+  size-cap:
+    uses: filiptrivan/ci-workflows/.github/workflows/size-cap.yml@main
